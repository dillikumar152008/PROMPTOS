# PromptOS - Environment Variables Template
# Variable NAMES only with empty values. Never commit real keys.

# Supabase Public Keys (browser-exposed)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# UI-only signup kill-switch. Set to 'true' to show the signup UI.
# Real enforcement: disable "Allow new users to sign up" in Supabase Dashboard → Authentication.
NEXT_PUBLIC_SIGNUPS_ENABLED=

# Server-Only Keys & Configuration
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Policy & Security Flags
# Set to 'true' only to allow raw image uploads (Known limitation: raw images skip server-side DLP)
ALLOW_RAW_IMAGES=
# Set to 'true' to fail closed if privacy receipt persistence fails (default: false = log & continue with receiptStatus 'unavailable')
RECEIPT_REQUIRED=

# Upstash Redis Rate Limiting (Phase C)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GLOBAL_DAILY_LIMIT=
USER_DAILY_LIMIT=
USER_RPM_LIMIT=

# Optional / Legacy Provider Variables
AI_PROVIDER=
AI_MODEL_GENERATE=
AI_MODEL_RUN=
AI_MODEL_FALLBACK=
XAI_API_KEY=

# Local Test Credentials (Optional - for running authenticated test suites)
TEST_EMAIL=
TEST_PASSWORD=
